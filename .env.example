# Optional: restricts which platforms/* resp. features/* packages are loaded at startup
# (comma-separated, e.g. "twitch"). Empty/unset = all of them.
BUGBOT_PLATFORMS=
BUGBOT_FEATURES=

# Optional: a different path for the SQLite file (default: features/sql_db/bugbot.db).
BUGBOT_DB=

DISCORD_TOKEN=

TWITCH_CHANNEL=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Scopes: chat:read chat:edit moderator:manage:banned_users moderator:manage:chat_messages
# (the last two are needed for automatic delete/timeout in platforms/twitch/bot.py and require
# this account to be a moderator in the channel)
TWITCH_CHAT_ACCESS_TOKEN=
TWITCH_CHAT_REFRESH_TOKEN=
TWITCH_CHAT_CLIENT_ID=

# Only needed when TWITCH_CHAT_CLIENT_ID is a different app from TWITCH_CLIENT_ID (e.g. because
# the token comes from a token generator): that app's secret. Without the matching secret the
# chat token cannot be renewed - with an identical client id, TWITCH_CLIENT_SECRET is used
# automatically and this line may stay empty.
TWITCH_CHAT_CLIENT_SECRET=

# --- OBS ---------------------------------------------------------------------------------
# OBS runs on the streamer's machine, the bot on a server: the bot does not call OBS, a relay
# on the OBS machine dials in to the bot (platforms/obs/client/obs_bridge.py). Without
# OBS_BRIDGE_TOKEN there is no OBS platform - that is how you run the bot without OBS.

# Shared secret with the relay. Generate a fresh one, e.g. with: openssl rand -hex 32
OBS_BRIDGE_TOKEN=

# Port on which the bot waits for the relay (default 4456). It does not become reachable
# through the firewall but through an SSH tunnel from the OBS machine - see docs/tunnel.md.
OBS_BRIDGE_PORT=

# Bind address (default 0.0.0.0). Correct that way in a container: the loopback restriction sits
# on the host side there (PublishPort=127.0.0.1:... in bugbot.container). If the bot runs
# directly on the server without a container, 127.0.0.1 belongs here.
OBS_BRIDGE_BIND=

# The password from the WebSocket server settings in OBS (Tools -> WebSocket Server Settings).
# Empty only when authentication is switched off there.
OBS_PASSWORD=

# --- Overlay -----------------------------------------------------------------------------
# The browser sources on screen do not fetch their data but dial in to the bot and get every
# change sent to them (features/overlay). The same reversed direction as with OBS and for the
# same reason. Without OVERLAY_TOKEN the bot opens no port; the feature still loads, so its chat
# commands (death counter) work without an overlay too.
#
# One listener for both halves of what is on screen: the stat bars (client/bars.html) and the
# chat mirrored alongside them (client/chat.html, formerly the separate chat_panel feature with
# its own CHAT_PANEL_TOKEN/-PORT/-BIND - folded in, see features/overlay/feature.py). Whoever
# only wants one of the two still needs just this section; the other is simply a browser source
# nobody adds, or one hidden via its eye icon in OBS.

# Shared secret with the browser sources. Generate a fresh one: openssl rand -hex 32
#
# It later stands in the browser source's URL (?token=...) and therefore in plaintext in the
# scene collection - there is no other way, the WebSocket API in the browser cannot set headers
# of its own. Hence: do not use the same one as OBS_BRIDGE_TOKEN. This one grants read access to
# a few numbers and to already-moderated chat, the other one remote control of a live broadcast.
OVERLAY_TOKEN=

# Port on which the bot waits for the overlays (default 4457). As with the relay it is not
# reachable through the firewall but through the SSH tunnel from the OBS machine - see
# docs/tunnel.md.
OVERLAY_PORT=

# Bind address (default 0.0.0.0). The same consideration as for OBS_BRIDGE_BIND: correct that
# way in a container, 127.0.0.1 belongs here without one.
OVERLAY_BIND=

# --- Companion ---------------------------------------------------------------------------
# A browser source with one small pet per chatter (features/companion). No settings of its
# own any more: the page rides on the overlay listener above (?role=companion) and signs in
# with OVERLAY_TOKEN - one port, one token for everything that only reads.

# --- TTS ---------------------------------------------------------------------------------
# Cheers with a message and !tts <text> are read out loud (platforms/twitch/features/tts). The
# speech is made here on the server; it rides on the overlay listener above (no port of its
# own): the browser source client/tts.html connects with OVERLAY_TOKEN, and two Stream Deck
# buttons release the queue - http://127.0.0.1:4457/tts/next?token=... and .../tts/skip.

# Secret for those buttons only (and /tts/count for a button label). Voices, pool and speech
# are set on the settings website instead (SETTINGS_TOKEN). Generate a fresh one: openssl rand -hex 32 - and do not
# reuse OVERLAY_TOKEN: that one sits in the scene collection and only grants reading, this one
# can make the stream talk. Empty = no buttons, nothing can release the queue.
TTS_TOKEN=

# Where the Piper voice models are (default: platforms/twitch/features/tts/voices). The
# container sets this itself (Dockerfile) - only needed when running without it.
TTS_VOICES_DIR=

# --- Settings website ----------------------------------------------------------------------
# Every JSON setting of the bot, editable in the browser (features/settings): through the
# tunnel at http://127.0.0.1:4457/settings?token=<SETTINGS_TOKEN>. Rides on the overlay
# listener, no port of its own. Changes go into settings/<name>.json, never into the repo.
#
# Its own secret, and a long one: this page can change everything the bot says and does.
# Generate it with openssl rand -hex 32 and reuse none of the tokens above. Empty = no website.
SETTINGS_TOKEN=
