# Optional: schränkt ein, welche platforms/*- bzw. features/*-Pakete beim Start geladen
# werden (kommagetrennt, z.B. "twitch"). Leer/nicht gesetzt = alle vorhandenen.
BUGBOT_PLATFORMS=
BUGBOT_FEATURES=

# Optional: abweichender Pfad für die SQLite-Datei (Default: bugbot.db im Projektordner).
BUGBOT_DB=

DISCORD_TOKEN=

TWITCH_CHANNEL=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Scopes: chat:read chat:edit moderator:manage:banned_users moderator:manage:chat_messages
# (letzte zwei werden für automatisches Delete/Timeout in platforms/twitch/bot.py benötigt und
# setzen voraus, dass dieser Account im Kanal Moderator ist)
TWITCH_CHAT_ACCESS_TOKEN=
TWITCH_CHAT_REFRESH_TOKEN=
TWITCH_CHAT_CLIENT_ID=

# Nur nötig, wenn TWITCH_CHAT_CLIENT_ID eine andere App ist als TWITCH_CLIENT_ID (z.B. weil der
# Token von einem Token-Generator stammt): das Secret dieser App. Ohne passendes Secret kann der
# Chat-Token nicht erneuert werden - bei gleicher Client-ID wird automatisch
# TWITCH_CLIENT_SECRET verwendet und diese Zeile kann leer bleiben.
TWITCH_CHAT_CLIENT_SECRET=

# --- OBS ---------------------------------------------------------------------------------
# OBS läuft auf dem Rechner des Streamers, der Bot auf einem Server: nicht der Bot ruft OBS an,
# sondern ein Relais auf dem OBS-PC wählt sich beim Bot ein (platforms/obs/obs_bridge.py).
# Ohne OBS_BRIDGE_TOKEN gibt es keine OBS-Plattform - so betreibt man den Bot ohne OBS.

# Gemeinsames Geheimnis mit dem Relais. Frisch erzeugen, z.B. mit: openssl rand -hex 32
OBS_BRIDGE_TOKEN=

# Port, auf dem der Bot auf das Relais wartet (Default 4456). Erreichbar wird er nicht über die
# Firewall, sondern über einen SSH-Tunnel vom OBS-Rechner - siehe README, Setup-Schritt 4.
OBS_BRIDGE_PORT=

# Bind-Adresse (Default 0.0.0.0). Im Container richtig so: die Loopback-Beschränkung steht dort
# auf der Host-Seite (PublishPort=127.0.0.1:... in bugbot.container). Läuft der Bot ohne
# Container direkt auf dem Server, gehört hier 127.0.0.1 hin.
OBS_BRIDGE_BIND=

# Das Passwort aus den WebSocket-Servereinstellungen von OBS (Werkzeuge -> WebSocket-Server).
# Leer nur, wenn dort die Authentifizierung aus ist.
OBS_PASSWORD=
