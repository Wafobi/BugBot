[Unit]
Description=BugBot - Twitch & Discord moderation/automation bot
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/bugbot:latest
ContainerName=bugbot
# Without this, rootless Podman maps the calling host user onto root in the container, and the
# bot (which runs as uid 1000 per the Dockerfile) ends up on a subuid that does not own the
# bugbot.db mounted from the host - SQLite then reports "readonly database" and the features
# needing storage fail at startup. This maps the host user onto uid 1000 in the container, i.e.
# onto exactly the user 'bugbot' from the Dockerfile - regardless of which uid they have on the
# host itself.
UserNS=keep-id:uid=1000,gid=1000
# Without this the container runs in UTC: the image brings no timezone along, and it does not
# inherit the host's. "local" adopts it (podman --tz), so the container shows the same time as
# `date` next to it.
#
# A safety net, not a prerequisite: the two times that end up in chat - {time}/{date} and the
# end of an ad break - take their timezone from variables.json ("timezone") and are right
# without this line too. It applies to anything that later looks at the clock without a
# timezone, and to keeping a `podman exec bugbot date` from being two hours out. Nothing else
# hangs on it: moderation windows and uptime work with time differences, and SQLite always
# writes the timestamps in bugbot.db in UTC via datetime('now') - chatlog.py converts them on
# reading.
Timezone=local
# Replace /path/to/bugbot below with the absolute path of your clone of this repo.
#
# Each of these files is mounted individually, and a bind mount onto a file hangs on its inode,
# not on its name. Overwriting takes effect immediately (that is what it is for); *replacing*,
# by contrast - vim with the default backupcopy, VS Code, sed -i, mv, git pull - leaves the old
# file standing here, and the container sees no change from then on. `python3 check_config.py`
# on the host reports that, `systemctl --user restart bugbot.service` fixes it. See
# docs/deployment.md#editing-in-place.
Volume=/path/to/bugbot/.env:/app/.env:Z
Volume=/path/to/bugbot/platforms/discord/discord.json:/app/platforms/discord/discord.json:Z
Volume=/path/to/bugbot/platforms/twitch/twitch.json:/app/platforms/twitch/twitch.json:Z
Volume=/path/to/bugbot/platforms/discord/features/levels/levels.json:/app/platforms/discord/features/levels/levels.json:Z
Volume=/path/to/bugbot/platforms/obs/obs.json:/app/platforms/obs/obs.json:Z
# The neutral features' configuration - without these mounts the version baked into the image
# would apply in the container, and a change on the host would have no effect.
Volume=/path/to/bugbot/features/moderation/moderation.json:/app/features/moderation/moderation.json:Z
Volume=/path/to/bugbot/features/variables/variables.json:/app/features/variables/variables.json:Z
Volume=/path/to/bugbot/features/stats/stats.json:/app/features/stats/stats.json:Z
Volume=/path/to/bugbot/features/chat_log/chat_log.json:/app/features/chat_log/chat_log.json:Z
Volume=/path/to/bugbot/features/sql_db/sql_db.json:/app/features/sql_db/sql_db.json:Z
Volume=/path/to/bugbot/features/overlay/overlay.json:/app/features/overlay/overlay.json:Z
Volume=/path/to/bugbot/features/sql_db/bugbot.db:/app/features/sql_db/bugbot.db:Z
# The first incoming port: this is where the OBS relay from the streamer's machine dials in
# (see platforms/obs/). Has to match OBS_BRIDGE_PORT from the .env. Anyone not connecting OBS
# leaves the line out.
#
# Deliberately bound to 127.0.0.1 and not to every address: the way in from outside is an SSH
# tunnel from the OBS machine (ssh -L 4456:127.0.0.1:4456 ...), not an open port. That way
# nothing stands on the internet that could remote-control a live broadcast, and the leg is
# encrypted on top - obs-websocket itself speaks unencrypted ws://.
#
# The bot *inside* the container nevertheless listens on 0.0.0.0 (OBS_BRIDGE_BIND) - it has its
# own network namespace, and Podman's port forwarding does not arrive there via its loopback.
# The restriction to loopback therefore belongs here, on the host side of the forward.
PublishPort=127.0.0.1:4456:4456

# The second: this is where the overlays hang (see features/overlay). Has to match OVERLAY_PORT
# from the .env. Anyone not embedding a browser source leaves the line out.
#
# The same arrangement and the same loopback restriction as above - an SSH tunnel from the OBS
# machine leads here too, and here too the bot in the container listens on 0.0.0.0.
#
# What goes out here is read-only (viewer count, last follower, game, death counter), and the
# listener accepts nothing from the far side. There is a token in front of it nonetheless: the
# `127.0.0.1:` in this line is the first lock, and it is exactly one forgotten prefix away from
# no longer being one.
PublishPort=127.0.0.1:4457:4457

[Service]
# always rather than on-failure: the bot should come back up even when the process ends cleanly
# with exit code 0 (e.g. when discord.py gives up on the connection for good and main() runs
# through normally). On "systemctl stop" the policy does not apply.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
